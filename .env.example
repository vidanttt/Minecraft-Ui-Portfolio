# Contact form delivery – configure ONE option, then copy this file to .env.local.
# With neither set, /api/contact answers 503 and the form says nothing was sent.

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional; must be a sender verified in Resend. Defaults to onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# Option B: POST the message as JSON to a webhook (Discord, Slack, Zapier, Make...)
CONTACT_WEBHOOK_URL=
